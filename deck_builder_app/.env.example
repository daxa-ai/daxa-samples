# Deck Builder App
PEBBLO_API_KEY=
PROXIMA_HOST=
USER_EMAIL=
USER_TEAM=
X_PEBBLO_USER=
X_PEBBLO_USER_GROUPS=
MODEL=
PEBBLO_USERS=
# user->groups mapping: semicolon-separated entries, each "user:group1,group2"
PEBBLO_USER_GROUPS_MAP=

# ── Insecure Inference (direct-to-model, no Daxa gateway) ────────────────────
OPENAI_API_KEY=

# ── Feature flags (show/hide each mode tab; blank or "true" = shown) ─────────
SHOW_SAFE_INFER=true
SHOW_INSECURE_INFER=true

# ── Documents section (Safe Infer sidebar reference links) ───────────────────
# Directory (relative to the app dir or absolute) listed in the sidebar.
DOCS_DIR=static
# Per-file group access control. Python dict: filename -> list of allowed groups.
# Files NOT listed here are visible to all users.
DOC_ACCESS_ALLOWED={}
